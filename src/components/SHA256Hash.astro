---
---

<div class="sha256-container">
  <label for="sha256-input" class="sha256-label">
    Ingresa el texto para generar el hash SHA-256:
  </label>
  <div class="sha256-input-group">
    <input
      type="text"
      id="sha256-input"
      class="sha256-input"
      placeholder="Escribe aquí..."
      autocomplete="off"
    />
  </div>
  <div class="sha256-output-group">
    <label class="sha256-output-label">Hash SHA-256:</label>
      <output id="sha256-output" class="sha256-output" for="sha256-input">
        Ingresa texto para ver el hash
      </output>
  </div>
</div>

<script>
  async function sha256(message: string): Promise<string> {
    const msgBuffer = new TextEncoder().encode(message);
    const hashBuffer = await crypto.subtle.digest('SHA-256', msgBuffer);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    return hashHex;
  }

  const input = document.getElementById('sha256-input') as HTMLInputElement;
  const output = document.getElementById('sha256-output') as HTMLOutputElement;

  let debounceTimer: ReturnType<typeof setTimeout>;

  async function updateHash() {
    const text = input.value;
    if (text.trim() === '') {
      output.textContent = 'Ingresa texto para ver el hash';
      output.classList.add('sha256-output-placeholder');
      return;
    }

    try {
      const hash = await sha256(text);
      output.textContent = hash;
      output.classList.remove('sha256-output-placeholder');
    } catch (error) {
      output.textContent = 'Error al generar el hash';
      output.classList.remove('sha256-output-placeholder');
    }
  }

  input.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(updateHash, 150);
  });

  // Initialize placeholder state
  output.classList.add('sha256-output-placeholder');
</script>

<style>
  .sha256-container {
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background-color: var(--sl-color-bg-inset);
  }

  .sha256-label {
    display: block;
    margin-bottom: 0.75rem;
    font-weight: 500;
    color: var(--sl-color-text);
    font-size: 0.95rem;
  }

  .sha256-input-group {
    margin-bottom: 1rem;
  }

  .sha256-input {
    width: 100%;
    margin-bottom: 0rem;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-family: var(--sl-font-mono);
    font-size: 0.9rem;
    transition: border-color 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    box-sizing: border-box;
  }

  .sha256-input::placeholder {
    color: var(--sl-color-gray-5);
    opacity: 1;
  }

  .sha256-input:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 2px var(--sl-color-accent-low);
  }

  .sha256-output-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sha256-output-label {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--sl-color-text);
  }

  .sha256-output {
    width: 100%;
    margin-top: 0rem;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background-color: var(--sl-color-bg);
    color: var(--sl-color-text);
    font-family: var(--sl-font-mono);
    font-size: 0.9rem;
    word-break: break-all;
    min-height: 2.5rem;
    display: flex;
    align-items: center;
    transition: color 0.2s ease-in-out;
    box-sizing: border-box;
  }

  .sha256-output-placeholder {
    color: var(--sl-color-gray-5);
    opacity: 1;
  }
</style>

